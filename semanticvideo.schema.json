{
  "$defs": {
    "AnalysisRun": {
      "additionalProperties": false,
      "description": "One resumable analysis execution and the outputs it produced.",
      "properties": {
        "analyzer": {
          "minLength": 1,
          "title": "Analyzer",
          "type": "string"
        },
        "analyzer_version": {
          "minLength": 1,
          "title": "Analyzer Version",
          "type": "string"
        },
        "annotation_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Annotation Ids",
          "type": "array"
        },
        "capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "analyzer",
        "analyzer_version",
        "started_at"
      ],
      "title": "AnalysisRun",
      "type": "object"
    },
    "AnnotationStatus": {
      "description": "Review state for probabilistic or human-authored observations.",
      "enum": [
        "machine_generated",
        "human_authored",
        "human_reviewed",
        "rejected"
      ],
      "title": "AnnotationStatus",
      "type": "string"
    },
    "Artifact": {
      "additionalProperties": false,
      "description": "Reference to a derived file kept outside the human-readable manifest.",
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "uri"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "AudioStream": {
      "additionalProperties": false,
      "description": "Technical metadata for one audio stream.",
      "properties": {
        "channel_layout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Layout"
        },
        "channels": {
          "exclusiveMinimum": 0,
          "title": "Channels",
          "type": "integer"
        },
        "codec": {
          "minLength": 1,
          "title": "Codec",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "const": "audio",
          "default": "audio",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "sample_rate": {
          "exclusiveMinimum": 0,
          "title": "Sample Rate",
          "type": "integer"
        },
        "time_base": {
          "anyOf": [
            {
              "$ref": "#/$defs/RationalRate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "index",
        "codec",
        "sample_rate",
        "channels"
      ],
      "title": "AudioStream",
      "type": "object"
    },
    "Checksum": {
      "additionalProperties": false,
      "description": "A content checksum used to detect stale sidecar data.",
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Checksum",
      "type": "object"
    },
    "CustomAnnotation": {
      "additionalProperties": false,
      "description": "Namespaced extension point for experimental annotation types.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "custom",
          "default": "custom",
          "title": "Kind",
          "type": "string"
        },
        "namespace": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$",
          "title": "Namespace",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "spatial_region": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpatialRegion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/AnnotationStatus"
        },
        "stream_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Id"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "time_range": {
          "$ref": "#/$defs/TimeRange"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "value": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Value",
          "type": "object"
        }
      },
      "required": [
        "id",
        "time_range",
        "status",
        "provenance",
        "namespace",
        "type",
        "value"
      ],
      "title": "CustomAnnotation",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "description": "A stable identity that can be referenced across time and assets.",
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "external_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "External Ids",
          "type": "object"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "type": {
          "$ref": "#/$defs/EntityType"
        }
      },
      "required": [
        "id",
        "type",
        "label"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EntityType": {
      "description": "Core entity categories; domain-specific categories use annotations.",
      "enum": [
        "person",
        "place",
        "organization",
        "object",
        "animal",
        "vehicle",
        "food",
        "landmark"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "EventAnnotation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "event",
          "default": "event",
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "spatial_region": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpatialRegion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/AnnotationStatus"
        },
        "stream_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Id"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "time_range": {
          "$ref": "#/$defs/TimeRange"
        },
        "value": {
          "$ref": "#/$defs/EventInfo"
        }
      },
      "required": [
        "id",
        "time_range",
        "status",
        "provenance",
        "value"
      ],
      "title": "EventAnnotation",
      "type": "object"
    },
    "EventInfo": {
      "additionalProperties": false,
      "description": "An action or occurrence involving zero or more entities.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "participant_entity_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Participant Entity Ids",
          "type": "array"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "title": "EventInfo",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A concrete observation supporting an annotation.",
      "properties": {
        "annotation_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Annotation Ids",
          "type": "array"
        },
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GeneratorInfo": {
      "additionalProperties": false,
      "description": "Software or model that produced a claim.",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "GeneratorInfo",
      "type": "object"
    },
    "GeoPoint": {
      "additionalProperties": false,
      "description": "A WGS84 coordinate.",
      "properties": {
        "altitude_meters": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Altitude Meters"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "GeoPoint",
      "type": "object"
    },
    "JsonValue": {},
    "LocationAnnotation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "location",
          "default": "location",
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "spatial_region": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpatialRegion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/AnnotationStatus"
        },
        "stream_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Id"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "time_range": {
          "$ref": "#/$defs/TimeRange"
        },
        "value": {
          "$ref": "#/$defs/LocationInfo"
        }
      },
      "required": [
        "id",
        "time_range",
        "status",
        "provenance",
        "value"
      ],
      "title": "LocationAnnotation",
      "type": "object"
    },
    "LocationInfo": {
      "additionalProperties": false,
      "description": "A place observation with optional stable entity and coordinates.",
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "point": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "LocationInfo",
      "type": "object"
    },
    "MediaInfo": {
      "additionalProperties": false,
      "description": "Identity and technical facts for the source media asset.",
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "$ref": "#/$defs/Checksum"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "container_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Format"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "duration": {
          "$ref": "#/$defs/RationalTime"
        },
        "file_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Size"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "modified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modified At"
        },
        "streams": {
          "items": {
            "discriminator": {
              "mapping": {
                "audio": "#/$defs/AudioStream",
                "subtitle": "#/$defs/SubtitleStream",
                "video": "#/$defs/VideoStream"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/VideoStream"
              },
              {
                "$ref": "#/$defs/AudioStream"
              },
              {
                "$ref": "#/$defs/SubtitleStream"
              }
            ]
          },
          "title": "Streams",
          "type": "array"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "id",
        "uri",
        "duration",
        "streams"
      ],
      "title": "MediaInfo",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Traceability record for a generated or human-authored claim.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/ProvenanceSource"
        }
      },
      "required": [
        "source",
        "generated_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceSource": {
      "description": "Broad source categories independent of a particular provider.",
      "enum": [
        "manual",
        "embedded_metadata",
        "signal_analysis",
        "local_model",
        "remote_model",
        "import"
      ],
      "title": "ProvenanceSource",
      "type": "string"
    },
