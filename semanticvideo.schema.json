          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "quality",
          "default": "quality",
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "spatial_region": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpatialRegion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/AnnotationStatus"
        },
        "stream_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Id"
        },
        "tags": {
